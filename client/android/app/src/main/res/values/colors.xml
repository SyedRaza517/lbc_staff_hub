<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme colours referenced by values/styles.xml.

  Without this file the resource compiler fails with
  "resource color/colorPrimary not found" and the Android app cannot be built at
  all — no debug APK, no release bundle. The Capacitor template's styles.xml
  references these three names but never ships their definitions.

  Values are the college brand: navy #1a3a8f, darker navy #14306f, maroon #9e1b32.
-->
<resources>
    <color name="colorPrimary">#1a3a8f</color>
    <color name="colorPrimaryDark">#14306f</color>
    <color name="colorAccent">#9e1b32</color>
</resources>
